# ============================================================
# AClimate v3 — Frontend Users WebAPI Environment Variables
# ============================================================
# Copy this file to .env and set real values locally.
# ⚠️ SECURITY: NEVER put real secrets here. This file is
# committed to the repo — use placeholders.
# ============================================================

# ─── Database (required by aclimate_v3_orm_frontend) ────────
# The ORM reads DATABASE_URL_FRONT (not DATABASE_URL).
# This is the separate "users" database (aclimate_frontend_users_db).
DATABASE_URL_FRONT=postgresql://postgres:CHANGE_ME@localhost:5432/aclimate_frontend_users_db

# ─── Keycloak auth ──────────────────────────────────────────
# Same Keycloak as the rest of the AClimate v3 ecosystem.
KEYCLOAK_URL=http://localhost:8080
REALM_NAME=CHANGE_ME
# Use the same client as the admin panel (aclimate_admin) or a dedicated one.
CLIENT_ID=CHANGE_ME
CLIENT_SECRET=CHANGE_ME

# ─── Security ───────────────────────────────────────────────
# Optional token to protect the /health and /ready endpoints.
# When set, requests must include the header: X-Health-Token: <value>
HEALTH_TOKEN=CHANGE_ME